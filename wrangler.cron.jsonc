{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "robertaviscardi-cron",
  "main": "server/worker.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": false,
  "triggers": { "crons": ["0 10 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "robertaviscardi",
      "database_id": "c4006ed9-233f-4baa-b18e-0824df71fdaf",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "ENABLE_AI": "false" }
  // Opcional para IA: adicione "ai": { "binding": "AI" } e habilite ENABLE_AI.
}
