# Opcional. URL relativa de uma fotografia real autorizada pela Roberta.
VITE_ROBERTA_PHOTO=

# Variáveis do servidor para Cloudflare Pages. Em desenvolvimento, use .dev.vars.
ACCESS_TEAM_DOMAIN=https://SEU-TIME.cloudflareaccess.com
ACCESS_AUD=
EDITOR_EMAIL=
ENABLE_AI=false
AI_MODEL=@cf/ibm-granite/granite-4.0-h-micro
AUTOMATIC_UPDATES=false

# Alternativa sem domínio próprio. Configure como segredos do Pages.
EDITOR_PASSWORD=
EDITOR_SESSION_KEY=
