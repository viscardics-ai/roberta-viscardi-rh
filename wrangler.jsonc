{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "robertaviscardi",
  "compatibility_date": "2026-05-15",
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "robertaviscardi",
      "database_id": "c4006ed9-233f-4baa-b18e-0824df71fdaf",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "ENABLE_AI": "false", "AUTOMATIC_UPDATES": "false" },
  "env": {
    "production": {
      "vars": { "ENABLE_AI": "true", "AUTOMATIC_UPDATES": "true" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "robertaviscardi",
          "database_id": "c4006ed9-233f-4baa-b18e-0824df71fdaf",
          "migrations_dir": "migrations"
        }
      ],
      "ai": { "binding": "AI" }
    }
  }
}
